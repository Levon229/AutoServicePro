            "maxLength": 24,
            "minLength": 0,
            "type": "string"
          },
          "vin": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          },
          "ownerName": {
            "maxLength": 120,
            "minLength": 0,
            "type": "string"
          },
          "ownerPhone": {
            "maxLength": 40,
            "minLength": 0,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateWorkOrderDto": {
        "required": [
          "issueDescription",
          "partsToUse"
        ],
        "type": "object",
        "properties": {
          "vehicleId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "issueDescription": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          },
          "laborCost": {
            "maximum": 999999999,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "partsToUse": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkOrderPartRequestDto"
            }
          }
        },
        "additionalProperties": false
      },
      "SparePartResponseDto": {
