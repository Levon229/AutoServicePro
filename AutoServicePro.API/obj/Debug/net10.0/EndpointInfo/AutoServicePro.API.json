  "components": {
    "schemas": {
      "CreateSparePartDto": {
        "required": [
          "name",
          "partNumber"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 0,
            "type": "string"
          },
          "partNumber": {
            "maxLength": 80,
            "minLength": 0,
            "type": "string"
          },
          "unitPrice": {
            "maximum": 999999999,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "stockQuantity": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreateVehicleDto": {
        "required": [
          "licensePlate",
          "make",
          "model",
          "ownerName",
          "ownerPhone",
          "vin"
        ],
        "type": "object",
        "properties": {
          "make": {
            "maxLength": 60,
            "minLength": 0,
            "type": "string"
          },
          "model": {
            "maxLength": 60,
            "minLength": 0,
            "type": "string"
          },
          "year": {
            "maximum": 2100,
            "minimum": 1886,
            "type": "integer",
            "format": "int32"
          },
